{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "html"],
  "vitest": {
    "configFile": "vitest.scripts.config.ts"
  },
  "mutate": ["scripts/**/*.ts", "!scripts/**/*.test.ts", "!scripts/**/run.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 85
  },
  "tempDirName": ".stryker-tmp-scripts",
  "htmlReporter": {
    "fileName": "reports/mutation/scripts.html"
  },
  "incrementalFile": "reports/stryker-incremental-scripts.json"
}
