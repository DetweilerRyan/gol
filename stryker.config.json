{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["progress", "clear-text", "html"],
  "mutate": ["src/gameOfLife.ts", "src/viewport.ts", "src/hooks/useCamera.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 85
  }
}
